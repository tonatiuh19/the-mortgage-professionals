# Copy to .env and fill in real values. See also .env.conversations.example.

# ─── Real-time (Ably) ─────────────────────────────────────────────────────────
# Required for live Conversations, Email, NotificationBell, Calendar sync, and voice.
# Create a key at https://ably.com/ — use the root or subscribe+publish key.
# ABLY_API_KEY=your_ably_api_key_here

# ─── Per-owner CRM (dev/ops only — not exposed in broker UI) ─────────────────
# Single master switch. Off by default → legacy tenant-wide client/phone behavior.
# When set (1/true/yes/on), non-admin brokers see only their assigned active clients.
# PER_OWNER_CRM_ENABLED=1

# Realtor Broadcast SMS engine (default: Twilio Messages API)
# Set BROADCAST_BULK_MESSAGING_ENABLED=1 to opt into Bulk Messaging (falls back to Messages until Bulk poller is fully ported)
# BROADCAST_BULK_MESSAGING_ENABLED=
# BROADCAST_SMS_ENGINE=messages
# BROADCAST_BULK_MIN_RECIPIENTS=1
# BROADCAST_BULK_CHUNK_SIZE=9000

# ─── Required in production (these routes reject requests when unset) ─────────
# CRON_SECRET=            # /api/cron/* — send as Authorization: Bearer <secret>
# INBOUND_WEBHOOK_SECRET= # /api/webhooks/inbound-email
# APP_URL=                # Canonical URL used to verify Twilio signatures

# Bulk CSV import is off in production unless enabled.
# BULK_CSV_IMPORT_ENABLED=1
